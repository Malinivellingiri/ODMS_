# Copy this file to .env only if you want to use environment variables.
# Default setup uses Windows SQL Server Express with Windows Authentication.
ODMS_DB_SERVER=localhost\SQLEXPRESS
ODMS_DB_NAME=ODMS
ODMS_DB_DRIVER=ODBC Driver 18 for SQL Server
ODMS_DB_TRUSTED=yes
ODMS_DB_USER=
ODMS_DB_PASSWORD=
ODMS_SECRET_KEY=change-this-secret-key
